<?xml version="1.0" encoding="utf-8"?>
<!-- PVB speaker correction: Korean. The default (values/strings_pvb.xml) is English. -->
<resources>
    <string name="pvb_enable">PVB 스피커 보정 (켜면 JamesDSP 대신 사용)</string>
    <string name="pvb_match_on_disable">끌 때 음량 맞춤</string>
    <string name="pvb_match_on_disable_summary">보정을 끄면 최근 재생 음량에 맞춘 원음을 들려줍니다. 처음에는 추정값을 쓰며 약 10초 평균으로 갱신합니다. 가상 저음 사용 중에는 비교를 위해 같은 지연을 유지합니다. 이 기능도 끄면 JamesDSP 처리를 사용합니다.</string>
    <string name="pvb_speaker_only">내장 스피커에서만 적용</string>
    <string name="pvb_speaker_only_summary">이어폰·블루투스로 바뀌면 자동으로 우회합니다</string>
    <string name="pvb_low_db">저중역 보정 크기</string>
    <string name="pvb_low_hz">저중역 보정 주파수</string>
    <string name="pvb_low_q">저중역 보정 폭 (Q)</string>
    <string name="pvb_hp_hz">저역 차단 주파수</string>
    <string name="pvb_hi_db">고역 감쇠 크기</string>
    <string name="pvb_hi_hz">고역 감쇠 주파수</string>
    <string name="pvb_hi_q">고역 감쇠 폭 (Q)</string>
    <string name="pvb_out_db">출력 레벨 (낮춘 만큼 볼륨을 올리세요)</string>
    <string name="pvb_ceil_db">리미터 상한</string>
    <string name="pvb_release_ms">리미터 회복 시간</string>
    <string name="pvb_vol_link">볼륨 연동 (실험)</string>
    <string name="pvb_vol_link_summary">볼륨이 낮을수록 저중역을 더 올립니다. 볼륨 표 실측 전이라 기본은 꺼짐</string>
    <string name="pvb_vol_ref_pct">기준 볼륨 (최대 대비 %)</string>
    <string name="pvb_vol_slope">낮아진 1 dB당 추가 보정</string>
    <string name="pvb_vol_cap_db">저중역 보정 상한</string>
    <string name="pvb_vol_max_db">최대 볼륨일 때의 보정</string>
    <string name="pvb_dyn_enable">조용한 구간 저음 추가 (실험)</string>
    <string name="pvb_dyn_enable_summary">폰 리미터에 여유가 있는 조용한 구간에서만 저중역을 조금 더 올립니다. 0.5~1초에 걸쳐 천천히 움직입니다</string>
    <string name="pvb_dyn_up_max_db">조용한 구간 최대 추가량</string>
    <string name="pvb_dyn_ref_db">추가를 시작하는 레벨 (높일수록 자주 걸림)</string>
    <string name="pvb_hs_db">고음 기울기 (스피커 고음 과잉 보정)</string>
    <string name="pvb_hs_hz">고음 기울기 시작 주파수</string>
    <string name="pvb_vb_enable">가상 저음 (알파 3)</string>
    <string name="pvb_vb_enable_summary">모드를 고르거나 모델과 크기를 직접 정해 저음의 풍성함과 무게를 더합니다. 모든 모델 약 0.15초 지연</string>
    <string name="pvb_vb_mode">모드</string>
    <string name="pvb_vb_algo">모델</string>
    <string name="pvb_vb_level">가상 저음 크기</string>
    <string name="pvb_vb_warning_title">가상 저음 (알파 3)</string>
    <string name="pvb_vb_warning">아직 청취 비교 중인 기능입니다.\n\n• 곡에 따라 저음 효과와 거슬림이 달라집니다.\n• 윙윙거림이나 기계음(버즈음)이 느껴지면 가상 저음 크기를 줄이거나 \'풍성함 증가\' 모드를 써 보세요. \'초저역 강조\' 모드는 저음이 빽빽한 곡에서 버즈음이 생길 수 있습니다.\n• 모든 모델에서 약 0.15초 지연이 있습니다.\n\n모델끼리 비교할 때는 같은 크기로 들어 보세요.</string>
    <string name="pvb_vb_warning_ok">알겠습니다, 켭니다</string>
    <!-- Alpha 3.1 per-song level memory -->
    <string name="pvb_vb_track_memory">곡별 세기 기억</string>
    <string name="pvb_vb_track_memory_off">곡이 재생 중일 때 가상 저음 크기(모드·모델 포함)를 바꾸면 그 곡에 기억하고, 다시 들을 때 자동으로 적용합니다. 곡 정보를 읽으려면 알림 접근 권한이 필요합니다.</string>
    <string name="pvb_vb_track_memory_no_access">켜짐 · 알림 접근 권한이 없어 재생 중인 곡을 알 수 없습니다. 아래 \'기억된 곡\'에서 권한을 허용해 주세요.</string>
    <string name="pvb_vb_track_memory_no_service">켜짐 · 오디오 서비스가 켜져 있을 때 재생 중인 곡을 확인합니다. 기본 세기 %1$s</string>
    <string name="pvb_vb_track_memory_no_track">켜짐 · 재생 중인 곡 없음 · 기본 세기 %1$s\n지금 크기를 바꾸면 기본 세기가 바뀝니다.</string>
    <string name="pvb_vb_track_memory_saved">지금: %1$s\n기억된 세기 사용 중 (%2$s) · 기본 세기 %3$s</string>
    <string name="pvb_vb_track_memory_default">지금: %1$s\n기본 세기 (%2$s) · 크기를 바꾸면 이 곡에 기억합니다.</string>
    <string name="pvb_vb_track_memory_access_title">알림 접근 권한 필요</string>
    <string name="pvb_vb_track_memory_access_message">재생 중인 곡의 제목·아티스트를 알려면 알림 접근 권한이 필요합니다. 미디어 세션의 곡 정보만 사용하며, 알림 내용은 읽거나 저장하지 않고 어디에도 보내지 않습니다.\n\n설정 화면에서 이 앱의 알림 접근을 허용한 뒤 돌아오세요. 몇 초 안에 반영됩니다.</string>
    <string name="pvb_vb_track_memory_access_open">설정 열기</string>
    <string name="pvb_vb_track_memory_access_later">나중에</string>
    <string name="pvb_vb_track_list">기억된 곡</string>
    <string name="pvb_vb_track_list_summary">%1$d곡 기억됨 · 눌러서 보기·지우기</string>
    <string name="pvb_vb_track_list_empty">아직 기억된 곡이 없습니다</string>
    <string name="title_activity_track_levels">기억된 곡</string>
    <string name="pvb_track_levels_status">상태</string>
    <string name="pvb_track_levels_access_ok">알림 접근 권한: 허용됨</string>
    <string name="pvb_track_levels_access_missing">알림 접근 권한: 필요</string>
    <string name="pvb_track_levels_access_missing_summary">눌러서 설정을 열고 이 앱의 알림 접근을 허용해 주세요. 권한이 없으면 곡을 알 수 없어 항상 기본 세기를 씁니다.</string>
    <string name="pvb_track_levels_on">곡별 세기 기억: 켜짐</string>
    <string name="pvb_track_levels_off">곡별 세기 기억: 꺼짐</string>
    <string name="pvb_track_levels_off_summary">가상 저음 카드에서 켤 수 있습니다. 꺼져 있는 동안에는 기억도, 자동 적용도 하지 않습니다. 기억된 곡은 그대로 남습니다.</string>
    <string name="pvb_track_levels_help">곡이 재생 중일 때 크기를 바꾸면 그 곡에 기억되고, 다시 재생하면 자동으로 적용됩니다. 기억이 없는 곡과 재생 중인 곡이 없을 때는 기본 세기(%1$s)를 씁니다. 최대 500곡까지 기억하며, 넘치면 가장 오래 듣지 않은 곡부터 지웁니다.</string>
    <string name="pvb_track_levels_list">기억된 곡 (%1$d)</string>
    <string name="pvb_track_levels_empty">아직 기억된 곡이 없습니다.</string>
    <string name="pvb_track_levels_entry_summary">%1$s · %2$s · %3$s</string>
    <string name="pvb_track_levels_now_playing">지금 재생 중 · %1$s</string>
    <string name="pvb_track_levels_no_artist">아티스트 없음</string>
    <string name="pvb_track_levels_delete_confirm">\'%1$s\'의 기억을 지울까요? 지금 재생 중이면 기본 세기로 돌아갑니다.</string>
    <string name="pvb_track_levels_delete">지우기</string>
    <string name="pvb_track_levels_clear_all">모두 지우기</string>
    <string name="pvb_track_levels_clear_all_summary">기억된 곡을 모두 지웁니다</string>
    <string name="pvb_track_levels_clear_all_confirm">기억된 곡 %1$d개를 모두 지울까요? 되돌릴 수 없습니다.</string>
    <!-- Alpha 3.2 volume-linked strength -->
    <string name="pvb_vb_vol_link">볼륨 연동 세기</string>
    <string name="pvb_vb_vol_link_off">볼륨을 올릴수록 가상 저음 세기를 자동으로 줄입니다. 큰 볼륨에서는 폰의 저음 보호 리미터가 먼저 걸려, 세기를 더해도 저음은 커지지 않고 중역이 눌리고 소리가 뭉개지기 때문입니다. 위 슬라이더 값은 그대로 두고, 재생할 때만 줄입니다.</string>
    <string name="pvb_vb_vol_link_on">볼륨 %1$s%% → %2$s (적용 세기 %3$s)\n%4$s%%부터 1%%당 %5$s dB씩, 최대 %6$s dB까지 줄입니다.</string>
    <string name="pvb_vb_vol_link_on_none">볼륨 %1$s%% → 줄이지 않음 (적용 세기 %2$s)\n%3$s%%부터 1%%당 %4$s dB씩, 최대 %5$s dB까지 줄입니다.</string>
    <string name="pvb_vb_vol_ref_pct">줄이기 시작 볼륨 (%)</string>
    <string name="pvb_vb_vol_ref_pct_summary">올리면 더 큰 볼륨부터 줄이기 시작해서, 같은 볼륨에서 가상 저음이 덜 줄어듭니다.</string>
    <string name="pvb_vb_vol_slope">볼륨 1%당 감소 (dB)</string>
    <string name="pvb_vb_vol_slope_summary">올리면 볼륨을 올릴 때 가상 저음이 더 빨리 줄어듭니다.</string>
    <string name="pvb_vb_vol_max_db">최대 감소 (dB)</string>
    <string name="pvb_vb_vol_max_db_summary">올리면 아주 큰 볼륨에서 가상 저음을 더 많이 줄일 수 있습니다.</string>
    <!-- Alpha 3.3 live blind A/B with saved verdicts -->
    <string name="title_activity_live_ab">실청 블라인드 비교</string>
    <string name="title_activity_live_ab_results">실청 비교 기록</string>
    <string name="pvb_vb_live_ab">실청 블라인드 비교</string>
    <string name="pvb_vb_live_ab_summary">내 음악을 실제 엔진으로 들으며 P1 크기, 볼륨 연동, 모델(D2, 기준형)을 블라인드로 비교하고 회차마다 판정을 저장해 내보냅니다.</string>
