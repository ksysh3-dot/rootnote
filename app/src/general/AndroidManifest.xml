<?xml version="1.0" encoding="utf-8"?>
<!-- General distribution build: merged over src/main/AndroidManifest.xml.
     The record-storing features (per-song memory, blind comparison records, buzz diagnostics with microphone
     recording and audio clips, measurement) do not exist in this build: their screens, service, provider and the
     microphone foreground-service permission are removed here, and BuildConfig.RECORD_FEATURES = false keeps their
     code paths from running. RECORD_AUDIO stays: Android requires it for system audio capture itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />

    <!-- Battery step of the first run (FirstWeek): the system dialog that exempts this app from battery
         optimisation, so One UI does not stop the capture service in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Quick exclusions (QuickExclude in pvb/FirstWeek.kt): the app only checks whether these video, live-streaming
         and call apps are installed. Keep this list equal to QuickExclude.APPS. -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="net.cj.cjhv.gs.tving" />
        <package android:name="kr.co.captv.pooqV2" />
        <package android:name="com.coupang.mobile.play" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.navercorp.game.android.community" />
        <package android:name="kr.co.nowcom.mobile.afreeca" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.discord" />
        <package android:name="com.microsoft.teams" />
    </queries>

    <!-- Only apps signed with the same key may switch processing on or off (release audit S7). -->
    <permission
        android:name="${applicationId}.permission.SET_POWER_STATE"
        android:protectionLevel="signature" />

    <application>
        <!-- Home screen of the general build (Compose). It is the launcher entry; the DSP screen (MainActivity)
             stays as "advanced settings" and keeps its other intent filters (audio effect panel, file import,
             tile preferences). -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.home.HomeActivity"
            android:exported="true"
            android:icon="@mipmap/ic_dsp_launcher"
            android:label="@string/app_brand_name"
            android:theme="@style/Theme.RootlessJamesDSP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- First-run welcome ("반가워요", three pages): replaces the first-run dialog; opened by the home screen on the
             first launch and by PvbGeneral.showFirstRunNotice. Not exported. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.home.WelcomeActivity"
            android:exported="false"
            android:label="@string/welcome_activity_title"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Spatial "좌우 맞추기" (speaker balance by microphones or by ear), landscape like listening. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.home.SpatialBalanceActivity"
            android:exported="false"
            android:label="@string/balance_title"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Spatial explanation as a landscape motion story (home screen (i)). Landscape only while it is open. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.home.SpatialStoryActivity"
            android:exported="false"
            android:label="@string/home_xtc_info_title"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Developer mode (Compose): opened from the About screen's research section or the PVB settings row once
             the research tools are unlocked. Not exported. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.devmode.DevModeActivity"
            android:exported="false"
            android:label="@string/dev_title"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- "저음 맞추기" (bass fit, devmode/BassFitActivity.kt): listening tests opened from developer mode. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.devmode.BassFitActivity"
            android:exported="false"
            android:label="@string/fit_title"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Settings and About in Compose (settings/RnSettingsActivity.kt); one instance per page (extra "route").
             The legacy SettingsActivity forwards here in this build. Not exported. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.settings.RnSettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Excluded apps in Compose (exclusions/RnExclusionsActivity.kt); BlocklistActivity forwards here. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.exclusions.RnExclusionsActivity"
            android:exported="false"
            android:label="@string/title_activity_blocklist"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Advanced settings in Compose (advanced/RnAdvancedActivity.kt); MainActivity forwards every start here in
             this build (files opened with the app, the audio-effect panel, the tile's long press). Not exported. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.advanced.RnAdvancedActivity"
            android:exported="false"
            android:label="@string/home_advanced_title"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- Setup steps in Compose (setup/RnSetupActivity.kt); OnboardingActivity forwards rootless setups here. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.setup.RnSetupActivity"
            android:exported="false"
            android:label="@string/onboarding_methods_title"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <!-- App compatibility in Compose (compat/RnAppCompatActivity.kt); AppCompatibilityActivity forwards here. -->
        <activity
            android:name="me.timschneeberger.rootlessjamesdsp.compat.RnAppCompatActivity"
            android:exported="false"
            android:label="@string/title_activity_app_compat"
            android:theme="@style/Theme.RootlessJamesDSP" />
        <activity android:name="me.timschneeberger.rootlessjamesdsp.activity.MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="me.timschneeberger.rootlessjamesdsp.activity.BuzzReportsActivity" tools:node="remove" />
        <service android:name="me.timschneeberger.rootlessjamesdsp.service.BuzzMicrophoneService" tools:node="remove" />
        <provider android:name="me.timschneeberger.rootlessjamesdsp.activity.BuzzFileProvider" tools:node="remove" />
        <activity android:name="me.timschneeberger.rootlessjamesdsp.activity.LiveAbActivity" tools:node="remove" />
        <activity android:name="me.timschneeberger.rootlessjamesdsp.activity.LiveAbResultsActivity" tools:node="remove" />
        <activity android:name="me.timschneeberger.rootlessjamesdsp.activity.TrackLevelsActivity" tools:node="remove" />

        <!-- Own action name and a signature permission instead of the upstream action open to every app. -->
        <receiver
            android:name="me.timschneeberger.rootlessjamesdsp.receiver.PowerStateReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.SET_POWER_STATE"
            tools:node="replace">
            <intent-filter>
                <action android:name="${applicationId}.SET_POWER_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name="me.timschneeberger.rootlessjamesdsp.service.QuickTileService"
            android:label="@string/app_brand_name"
            tools:replace="android:label" />
    </application>
</manifest>
