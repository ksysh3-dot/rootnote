    <string name="dev_p_rolloff_up">(가파르게) 부드럽고 둥근 저음이 돼요. 너무 가파르면 효과가 거의 사라져요.</string>
    <string name="dev_p_rolloff_down">(완만하게) 또렷하고 단단해지지만 거칠어질 수 있어요.</string>
    <string name="dev_p_rolloff_note">연구에서는 옥타브당 3~10 dB 범위가 쓰였어요.</string>
    <string name="dev_p_sust_name">지속음 배음</string>
    <string name="dev_p_sust_line">길게 이어지는 저음(베이스)에 얼마나 배음을 줄지 정해요.</string>
    <string name="dev_p_sust_up">베이스 라인이 진해져요.</string>
    <string name="dev_p_sust_note">지속음 쪽 방식은 소리를 조금 번지게 해서, 킥을 지속음 쪽에 맡기면 \"쿵!\"이 아니라 \"쿠웅…\"이 될 수 있어요.</string>
    <string name="dev_p_perc_name">타격음 배음</string>
    <string name="dev_p_perc_line">짧게 치는 저음(킥)에 얼마나 배음을 줄지 정해요.</string>
    <string name="dev_p_perc_up">킥이 단단해져요. 너무 올리면 칠 때마다 지직거릴 수 있어요.</string>
    <string name="dev_p_attack_name">어택 (켜지는 속도)</string>
    <string name="dev_p_attack_line">저음이 시작될 때 배음이 얼마나 빨리 따라 켜질지 정해요.</string>
    <string name="dev_p_attack_up">부드러워지지만 킥이 흐려져요.</string>
    <string name="dev_p_attack_down">킥이 단단해져요. 너무 짧으면 시작마다 \"틱\" 소리가 날 수 있어요.</string>
    <string name="dev_p_release_name">릴리즈 (꺼지는 속도)</string>
    <string name="dev_p_release_line">저음이 끝날 때 배음이 얼마나 빨리 사라질지 정해요.</string>
    <string name="dev_p_release_up">저음이 길게 남아 풍성하지만, 원래 소리보다 늦게 사라지면 \"쿠웅\" 꼬리가 생겨요.</string>
    <string name="dev_p_release_down">원래 소리처럼 딱 끊겨요. 너무 짧으면 저음이 떨리듯 들릴 수 있어요.</string>
    <string name="dev_p_x_rise_name">급상승 완화 (실험 기능)</string>
    <string name="dev_p_x_rise_line">배음이 갑자기 크게 튀어 오르는 순간을 눌러요.</string>
    <string name="dev_p_x_rise_up">킥 첫머리의 지직거림이 줄 수 있어요. 대신 첫 타격이 조금 약해져요.</string>
    <string name="dev_p_x_smooth_name">층 출렁임 완화 (실험 기능)</string>
    <string name="dev_p_x_smooth_line">배음 크기가 빠르게 출렁이는 것을 눌러요.</string>
    <string name="dev_p_x_smooth_up">\"훙훙\" 하는 울렁임이 줄 수 있어요. 소리가 시작된 직후 0.5초쯤 배음이 작게 나와요.</string>
    <string name="dev_p_x_s1m_name">배음별 단일 포락선 (실험 기능)</string>
    <string name="dev_p_x_s1m_line">배음마다 크기 변화를 하나로 이어, 갑자기 끊겼다 이어지는 일을 줄여요.</string>
    <string name="dev_p_x_s1m_up">그만큼 커지는 가상 저음을 2 dB 낮춰요. 켜고 끌 때 소리가 잠깐 끊겨요.</string>
    <string name="dev_p_x_s1m_note">\"연결형(P1)\" 모델에서만 작동해요.</string>
    <string name="dev_p_strength_name">세기</string>
    <string name="dev_p_strength_line">만든 배음 전체의 크기예요.</string>
    <string name="dev_p_strength_up">저음이 진해지지만, 일정 이상에서는 더 커지지 않고 지직거림과 중고음 눌림만 늘어요.</string>
    <string name="dev_p_strength_note">폰 앰프의 보호 동작 때문에, 같은 세기라도 볼륨이 클수록 더 빨리 한계에 닿아요.</string>
    <string name="dev_p_vol_start_name">볼륨 연동 시작</string>
    <string name="dev_p_vol_start_line">볼륨을 올릴수록 세기를 자동으로 줄여요. 이 볼륨부터 줄이기 시작해요.</string>
    <string name="dev_p_vol_start_down">더 낮은 볼륨부터 줄여서 지직거림이 줄어요.</string>
    <string name="dev_p_vol_start_note">폰 앰프는 볼륨과 배터리 상태에 따라 출력을 제한해요. 배터리가 적을 때 저음이 약해지는 것도 같은 이유예요.</string>
    <string name="dev_p_vol_slope_name">볼륨 연동 기울기</string>
    <string name="dev_p_vol_slope_line" formatted="false">볼륨을 1% 올릴 때마다 세기를 얼마나 줄일지예요.</string>
    <string name="dev_p_vol_slope_up">볼륨을 올릴 때 더 많이 줄여요.</string>
    <string name="dev_p_vol_max_name">볼륨 연동 최대</string>
    <string name="dev_p_vol_max_line">볼륨 연동으로 가장 많이 줄이는 양이에요.</string>
    <string name="dev_p_vol_max_up">아주 큰 볼륨에서 더 많이 줄일 수 있어요.</string>
    <string name="dev_p_x_dense_name">복합음 감응 세기 (실험 기능)</string>
    <string name="dev_p_x_dense_line">중고음이 빽빽한 순간에 배음을 잠깐 줄여요.</string>
    <string name="dev_p_x_dense_up">여러 악기가 한꺼번에 울릴 때의 미세한 지직거림이 줄 수 있어요. 그 순간 저음도 조금 약해져요.</string>
    <string name="dev_ev_boundary_0">작은 스피커용 가상 저음은 보통 100~200 Hz 사이에서 \"이 아래는 스피커가 못 낸다\"는 경계(차단 주파수)를 잡아요.</string>
    <string name="dev_ev_boundary_1">S26 Ultra는 150~180 Hz 아래가 급히 떨어져요. 기본값 190 Hz는 이 측정으로 정했어요.</string>
    <string name="dev_ev_out_0">배음 대역은 보통 차단 주파수부터 그 4배 정도까지예요.</string>
    <string name="dev_ev_out_1">S26 Ultra는 400 Hz 위를 바꿔도 차이가 들리지 않았어요.</string>
    <string name="dev_ev_hp_0">작은 스피커용 가상 저음은 원음을 차단 주파수에서 잘라요.</string>
    <string name="dev_ev_hp_1">스마트 앰프는 진동판이 너무 많이 움직이지 않게 실시간으로 출력을 제한해요.</string>
    <string name="dev_ev_hp_2">몸통이 얇아지는 정도는 기기마다 달라요. 아직 확인 안 됐어요.</string>
    <string name="dev_ev_harm_0">음 높이 인식은 대체로 1~5번째 배음이 좌우하고, 배음 3개만으로도 효과가 나요.</string>
    <string name="dev_ev_harm_1">Galaxy S26 Ultra에서는 220~400 Hz가 과하면 \"쿠훙\" 노이즈가 생겼어요.</string>
    <string name="dev_ev_harm_2">차수별로 따로 올리고 내린 효과는 아직 확인 안 됐어요.</string>
    <string name="dev_ev_rolloff_0">한 연구는 배음 크기를 옥타브당 3~10 dB 사이로 제한했어요.</string>
    <string name="dev_ev_rolloff_1">S26 Ultra는 400 Hz 위 변화가 들리지 않아, 이 수치의 효과가 작았어요.</string>
    <string name="dev_ev_mix_0">위상 보코더는 순간음을 번지게 하고, 비선형 방식은 순간음에 강해요. 둘을 나누는 혼합 방식이 더 좋은 평가를 받았어요.</string>
    <string name="dev_ev_mix_1">S26 Ultra에서 킥 꼬리를 확인했어요.</string>
    <string name="dev_ev_attack_0">일반 동적 처리 원리에서 나온 예상이에요. 그림의 시간 그래프로 확인하세요.</string>
    <string name="dev_ev_release_0">S26 Ultra에서 생성층이 원음보다 40~60 ms 늦게 사라질 때 킥이 흐려졌어요.</string>
    <string name="dev_ev_release_1">그 밖의 일반론은 추정이에요.</string>
    <string name="dev_ev_x_rise_0">S26 Ultra 7·8차 청취에서 조금 나았어요.</string>
    <string name="dev_ev_x_smooth_0">S26 Ultra 6차 청취의 오프라인 처리에서 울렁임이 사라졌어요. 앱판은 방식이 달라 아직 확인 안 됐어요.</string>
    <string name="dev_ev_x_s1m_0">오프라인 연구 처리를 앱에 옮긴 기능이에요. 앱에서의 효과는 아직 확인 안 됐어요.</string>
    <string name="dev_ev_strength_0">저음 향상의 양과 음질 저하 사이에는 분명한 맞바꿈이 있어요. 많이 넣을수록 왜곡이 들려요.</string>
    <string name="dev_ev_strength_1">폰의 스마트 앰프는 진동판과 온도를 보호하려고 출력을 제한해요.</string>
    <string name="dev_ev_strength_2">S26 Ultra에서 +6보다 +3~4가 깨끗했어요.</string>
    <string name="dev_ev_vol_0">앰프에는 배터리 전압을 따라가는 리미터와 진동판 보호가 있어요.</string>
    <string name="dev_ev_vol_1" formatted="false">S26 Ultra는 볼륨 80%에서 저역 보호 문턱이 약 −27 dBFS, 50%에서 약 −15 dBFS였어요. 볼륨 연동으로 지직거림이 크게 줄었어요.</string>
    <string name="dev_ev_x_dense_0">큰 저음이 진동판을 흔들 때 중고음이 함께 일그러지는 상호변조 현상에서 나온 예상이에요.</string>
    <string name="dev_ev_x_dense_1">S26 Ultra 19차 청취에서는 같은 평균 크기 고정과 구분되지 않았어요.</string>
</resources>
