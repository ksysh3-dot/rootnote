<resources>
    <string name="fit_title">Bass fit</string>
    <string name="fit_entry_line">Find the bass values for this phone\'s speaker by ear. Takes about 10 minutes.</string>
    <string name="fit_intro_title">Find the bass for this phone</string>
    <string name="fit_intro_body">By ear, find how low the speaker goes, how much virtual bass to add, and where it starts to buzz. The order of the questions and the A/B sides change every time.</string>
    <string name="fit_intro_1">Set your usual listening volume. If the volume changes during the test, it pauses.</string>
    <string name="fit_intro_2">Listen in a quiet place, on the phone\'s speaker, holding the phone as usual.</string>
    <string name="fit_intro_3">Nothing changes until you save, and you can undo it afterwards.</string>
