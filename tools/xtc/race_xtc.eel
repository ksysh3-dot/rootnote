desc: Phone speaker crosstalk cancellation (RACE-style, test)
//tags: stereo, xtc
// Recursive crosstalk cancellation for the two built-in speakers, landscape, music at about 30-50 cm.
// Each output subtracts the other output delayed by the head's crosstalk delay tau and scaled by g. The feedback path is
// band-limited with first-order filters (high-pass fLo, low-pass fHi) and shaped by a first-order head-shadow shelf, so
// the bass and the top end are left almost untouched. "Centre safe" applies the
// recursion to the side signal only, so centre sounds (vocals) keep their tone; "Full RACE" also cancels for the
// centre and separates more, at the cost of tone. tau comes from a standard spherical head (Woodworth) and the
// listening distance: no measurement needed. Design notes and the model: tools/xtc/race_design.py, docs/XTC_PLAN.md.

mode:0<0,1,1{Centre safe (side only),Full RACE}>Mode
strength:0<0,2,1{Gentle (-6 dB),Medium (-4.5 dB),Strong (-3 dB)}>Strength
distance:40<25,60,1>Listening distance (cm)
headSize:1<0,2,1{Small (hat 54 cm),Medium (hat 57 cm),Large (hat 60 cm)}>Head size
spacing:15.5<10,20,0.1>Speaker spacing in landscape (cm)
fLo:400<150,1500,10>Band low edge (Hz)
fHi:8000<3000,16000,100>Band high edge (Hz)
bypass:0<0,1,1{Off,On}>Bypass

@init
mode = 0;
strength = 0;
distance = 40;
headSize = 1;
spacing = 15.5;
fLo = 400;
fHi = 8000;
bypass = 0;

// ---- design ----
g = strength == 0 ? 0.501187 : (strength == 1 ? 0.595662 : 0.707946);   // -6 / -4.5 / -3 dB
radius = 0.0875 * (headSize == 0 ? 54 : (headSize == 1 ? 57 : 60)) / 57;  // m, standard head scaled by hat size
theta = atan((spacing * 0.005) / (distance * 0.01));                     // speaker angle from the front (rad)
tau = radius / 343 * (theta + sin(theta));                               // Woodworth crosstalk delay (s)
tauSamples = tau * srate;
// the loop already delays by one sample (the previous output is fed back)
loopDelay = max(tauSamples - 1, 0);

// first-order sections, bilinear; 5 slots each: b0 b1 a1 z1 (unused)
function fo1Set(base, b0, b1, a0, a1) (
    base[0] = b0 / a0; base[1] = b1 / a0; base[2] = a1 / a0; base[3] = 0;
);
function fo1(base, x) local(y) (
    y = base[0] * x + base[3];
    base[3] = base[1] * x - base[2] * y;
    y;
);
function loopSet(base) local(k, w0, kk, alphaNear, alphaFar, bS, aS) (
    k = tan($pi * fLo / srate);                  // high-pass
    fo1Set(base, 1, -1, 1 + k, k - 1);
    k = tan($pi * fHi / srate);                  // low-pass
    fo1Set(base + 5, k, k, 1 + k, k - 1);
    // head shadow far ear / near ear (Brown-Duda form, alpha_min 0.1, theta_min 150 deg), bilinear at 2 fs
    alphaNear = 1.05 + 0.95 * cos(($pi / 2 - theta) / (150 / 180 * $pi) * $pi);
    alphaFar = 1.05 + 0.95 * cos(($pi / 2 + theta) / (150 / 180 * $pi) * $pi);
    w0 = 343 / radius;
    kk = 2 * srate;
    bS = alphaFar / (2 * w0) * kk;
    aS = alphaNear / (2 * w0) * kk;
    fo1Set(base + 10, 1 + bS, 1 - bS, 1 + aS, 1 - aS);
);
function loopRun(base, x) (
    fo1(base + 10, fo1(base + 5, fo1(base, x)));
);

// memory: two fractional delay lines, then two loop filters (A, B)
dlA = 0;
req = fractionalDelayLineInit(dlA, 64);
dlB = dlA + req;
req = fractionalDelayLineInit(dlB, 64);
lpA = dlB + req + 16;
lpB = lpA + 16;
loopSet(lpA);
loopSet(lpB);
fractionalDelayLineSetDelay(dlA, loopDelay);
fractionalDelayLineSetDelay(dlB, loopDelay);

yA = 0; yB = 0;   // previous outputs fed back (full: left / right; centre safe: side / unused)

@sample
bypass == 0 ? (
    mode == 1 ? (
        // full RACE: yL = xL - g * B[yR(t - tau)], yR = xR - g * B[yL(t - tau)]
        fbR = loopRun(lpB, fractionalDelayLineProcess(dlB, yB));
        fbL = loopRun(lpA, fractionalDelayLineProcess(dlA, yA));
        yA = spl0 - g * fbR;
        yB = spl1 - g * fbL;
        spl0 = yA;
        spl1 = yB;
    ) : (
        // centre safe: mid unchanged, side S = s + g * B[S(t - tau)]
        mid = (spl0 + spl1) * 0.5;
        side = (spl0 - spl1) * 0.5;
        yA = side + g * loopRun(lpA, fractionalDelayLineProcess(dlA, yA));
        spl0 = mid + yA;
        spl1 = mid - yA;
    );
);
