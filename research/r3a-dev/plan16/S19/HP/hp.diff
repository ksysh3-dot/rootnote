+    double ph = 0;
+    for (int j = 0; j < p_.layerHpOrder / 2; ++j) {
+        const HpBiquad& s = hp_[j];
+        const double nr = s.b0 + s.b1 * c1 + s.b2 * c2, ni = -(s.b1 * s1 + s.b2 * s2);
+        const double dr = 1 + s.a1 * c1 + s.a2 * c2, di = -(s.a1 * s1 + s.a2 * s2);
+        ph += std::atan2(ni, nr) - std::atan2(di, dr);
+    }
+    return ph;
